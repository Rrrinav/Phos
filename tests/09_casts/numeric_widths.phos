print("sat i8 max", 127 sat i8, 128 sat i8, 1000 sat i8, sep = " ");
print("sat u8", 255 sat u8, 256 sat u8, 0 sat u8, sep = " ");
print("sat i16", 32767 sat i16, 100000 sat i16, sep = " ");
print("sat u16", 65535 sat u16, 70000 sat u16, sep = " ");
let w := 1000;
print("wrap", w as i8, sep = " ");
let wu := 40000;
print("wrap16", wu as i16, sep = " ");
let neg := -1;
print("neg wrap", neg as u8, sep = " ");
print("float trunc", 3.99 as i32, sep = " ");
let nf := -2.7;
print("neg trunc", nf as i32, sep = " ");
print("int to float", 7 as f64, sep = " ");
let neg200 := -200;
print("sat neg var", neg200 sat i8, sep = " ");
print("sat paren", (-200) sat i8, (-128) sat i8, sep = " ");
let w1: i16 = 32000;
let w2: i32 = w1;
print("widen", w2, sep = " ");
let w5: u8 = 255;
let w6: u32 = w5;
print("uwiden", w6, sep = " ");
print("hex", 0xff, 0b1010, 0o755, 1_000_000, 1.5e2, sep = " ");
print("sfx", 1i16, 8080u16, 21.5f32, sep = " ");
