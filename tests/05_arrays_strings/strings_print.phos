print("A", "B", "C", sep = " | ", end = " <done>\n");
print("x", "y", sep = "");
let raw := "  phos lang  ";
let clean := raw.trim();
print("[" + clean + "]");
print(clean.split(" "));
print(clean.starts_with("phos"));
print(clean.ends_with("lang"));
print(clean.index_of("lang"));
print("missing", "abc".index_of("z").is_nil(), sep = "");
print("sub", "hello".substr(1, 3), sep = "");
print("upper", "hi".to_upper(), sep = "");
print("lower", "HI".to_lower(), sep = "");
print("repeat", "ab".repeat(3), sep = "");
print("tostring", to_string(42), to_string(2.5), sep = "");
let pi := parse_i64("  123  ");
print("parse", pi.get(), sep = "");
let bad := parse_i64("abc");
print("parse bad", bad.is_nil(), sep = "");
let pf := parse_f64("2.5");
print("parsef", pf.get(), sep = "");
let b: u8[] = "Hi" as u8[];
print(len(b), b[0], b[1], sep = " ");
let s: string = b as string;
print(s);
print("bytelen", len("héllo"), sep = "");
